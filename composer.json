{
    "name": "ignacio/cava-noble",
    "description": "Professional Wine E-Commerce built with PHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse app tests",
        "autoload": "composer dump-autoload --optimize"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}